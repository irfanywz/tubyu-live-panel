# Port dan alamat (127.0.0.1 = hanya bisa diakses dari laptop ini)
PORT=3000
HOST=127.0.0.1

# Path ffmpeg. Kosongkan kalau sudah ada di PATH.
# Windows contoh: C:\ffmpeg\bin\ffmpeg.exe
# Kosongkan untuk pakai FFmpeg bawaan (ffmpeg-static).
# Isi hanya kalau mau pakai FFmpeg sendiri.
# FFMPEG_PATH=

# Kunci enkripsi stream key, 64 karakter hex (32 byte).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENC_KEY=

# Set true kalau sudah pakai HTTPS
COOKIE_SECURE=false

# Opsional
# DB_PATH=./data/app.db
# STORAGE_DIR=./storage
# RTMP_BASE=rtmps://a.rtmps.youtube.com:443/live2/

# Isi 1 kalau berjalan di belakang reverse proxy (Caddy/nginx)
# TRUST_PROXY=1
